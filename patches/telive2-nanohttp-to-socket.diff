-	if (!ctxt) { fprintf(stderr,"blad http\n"); return(0); }
-
-	fflush(stdout); fflush(stderr); 
-	ret = xmlNanoHTTPReturnCode(ctxt);
-
-	if (content_type) {  xmlFree(content_type); }
-	if (ret!=200) {
-		xmlNanoHTTPClose(ctxt);
-		return(0);
-	}
-
-	len = xmlNanoHTTPRead(ctxt, outbuf, sizeof(outbuf));
-	xmlNanoHTTPClose(ctxt);
+	(void)ctxt; (void)content_type;
+	fflush(stdout); fflush(stderr);
 
+	/* OsmoTetraUbuntu: era xmlNanoHTTPMethod/ReturnCode/Read/Close, rimossi
+	 * da libxml2 2.14. xmlrpc_http_post restituisce i byte del corpo, o -1. */
+	len = xmlrpc_http_post(url, postbuf, outbuf, sizeof(outbuf));
 	if (len<1) {
+		fprintf(stderr,"blad http\n");
 		return(0);
 	}
 
