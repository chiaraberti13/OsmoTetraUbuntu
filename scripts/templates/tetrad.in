#!/bin/bash
# tetrad - ricomprime in OGG le chiamate registrate da telive in ACELP
#
# Generato da OsmoTetraUbuntu a partire da scripts/templates/tetrad.in.
# Basato su telive/bin/tetrad di Jacek Lipkowski SQ5BPF, con le directory rese
# configurabili e qualche irrobustimento (quoting, file senza data, uscita
# pulita su SIGTERM).
#
# Gira in background finché non viene fermato: ogni 60 s cerca in $TDIR i file
# .out non toccati da almeno 2 minuti (cioè a chiamata conclusa) e li converte
# in $ODIR/AAAAMMGG/nome.ogg.
#
# SPDX-License-Identifier: GPL-3.0-or-later
set -uo pipefail

CODEC_BIN="@CODEC_BIN@"
TDIR="${TETRA_OUTDIR:-@TETRA_IN@}"
ODIR="${TETRA_OGGDIR:-@TETRA_OUT@}"
INTERVAL="${TETRAD_INTERVAL:-60}"
MIN_AGE="${TETRAD_MIN_AGE:-2}"   # minuti

trap 'echo "tetrad: uscita"; exit 0' TERM INT

for tool in "$CODEC_BIN/cdecoder" "$CODEC_BIN/sdecoder"; do
	if [ ! -x "$tool" ]; then
		echo "tetrad: codec vocale ACELP non installato ($tool mancante)" >&2
		echo "tetrad: esegui scripts/40_install_codec.sh (o il pulsante nella GUI)" >&2
		exit 1
	fi
done
for tool in sox oggenc; do
	command -v "$tool" >/dev/null 2>&1 || { echo "tetrad: '$tool' non installato" >&2; exit 1; }
done

echo "tetrad: sorveglio $TDIR -> $ODIR (ogni ${INTERVAL}s)"

convert_one() {
	local src="$1" base date_part destdir
	base="$(basename "$src" .out)"

	# I nomi prodotti da telive sono traffic_AAAAMMGG_HHMMSS_...; se il
	# pattern non combacia si usa la data odierna invece di creare una
	# directory con dentro il nome intero del file.
	if [[ "$base" =~ _([0-9]{8})_ ]]; then
		date_part="${BASH_REMATCH[1]}"
	else
		date_part="$(date +%Y%m%d)"
	fi
	destdir="$ODIR/$date_part"
	mkdir -p "$destdir" || return 1

	local work="$destdir/$base"
	# Sposta prima di lavorare: evita che il giro successivo riprenda lo
	# stesso file se la conversione è lenta.
	mv -- "$src" "$work.out" || return 1

	if "$CODEC_BIN/cdecoder" "$work.out" "$work.codec" \
		&& "$CODEC_BIN/sdecoder" "$work.codec" "$work.raw" \
		&& sox -r 8k -e signed -b 16 -c 1 "$work.raw" "$work.wav" \
		&& oggenc -Q -o "$work.ogg" "$work.wav"; then
		echo "tetrad: $(basename "$work.ogg")"
	else
		echo "tetrad: conversione fallita per $base, lascio $work.out" >&2
		rm -f -- "$work.codec" "$work.raw" "$work.wav"
		return 1
	fi
	rm -f -- "$work.out" "$work.codec" "$work.raw" "$work.wav"
}

while :; do
	while IFS= read -r -d '' f; do
		convert_one "$f" || true
	done < <(find "$TDIR" -type f -name '*.out' -mmin "+$MIN_AGE" -print0 2>/dev/null)
	sleep "$INTERVAL" &
	wait $!
done
