#!/bin/sh
# tplay - riproduce un file audio TETRA in formato ACELP grezzo
#
# Generato da OsmoTetraUbuntu a partire da scripts/templates/tplay.in.
# Basato su telive/bin/tplay di Jacek Lipkowski SQ5BPF, con la directory del
# codec resa configurabile invece di /tetra/bin cablato.
#
# telive lo invoca con popen("tplay >/dev/null 2>&1", "w") e gli scrive i
# frame sullo standard input, quindi senza argomenti deve leggere da stdin.
#
# SPDX-License-Identifier: GPL-3.0-or-later

CODEC_BIN="@CODEC_BIN@"

if [ ! -x "$CODEC_BIN/cdecoder" ] || [ ! -x "$CODEC_BIN/sdecoder" ]; then
	echo "tplay: codec vocale ACELP non installato in $CODEC_BIN" >&2
	echo "tplay: esegui scripts/40_install_codec.sh (o il pulsante nella GUI)" >&2
	# Consuma comunque lo stdin: se uscissimo subito, telive riceverebbe
	# SIGPIPE alla prima scrittura sulla pipe.
	cat > /dev/null
	exit 1
fi

cat -- "$@" \
	| "$CODEC_BIN/cdecoder" /dev/stdin /dev/stdout \
	| "$CODEC_BIN/sdecoder" /dev/stdin /dev/stdout \
	| aplay -q -f S16_LE -r 8000 -c 1
